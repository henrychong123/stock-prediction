# Copy this to .env and fill in your API keys

# Finnhub (free at https://finnhub.io/register)
FINNHUB_API_KEY=your_finnhub_key_here

# Reddit (create app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=StockPredictor/1.0

# NewsAPI (free at https://newsapi.org/register) - optional, for Malaysia news
NEWSAPI_KEY=your_newsapi_key_here

# Default market: US or MY
DEFAULT_MARKET=US
