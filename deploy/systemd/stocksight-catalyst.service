[Unit]
Description=StockSight Catalyst Scanner
After=network.target

[Service]
Type=oneshot
User=stocksight
Group=stocksight
WorkingDirectory=/opt/stocksight
Environment=PATH=/opt/stocksight/venv/bin:/usr/bin
EnvironmentFile=/opt/stocksight/.env
ExecStart=/opt/stocksight/venv/bin/python catalyst_scanner.py --hours 6
TimeoutStartSec=600
