[Unit]
Description=StockSight Daily Feature Collector
After=network.target

[Service]
Type=oneshot
User=stocksight
Group=stocksight
WorkingDirectory=/opt/stocksight
Environment=PATH=/opt/stocksight/venv/bin:/usr/bin
EnvironmentFile=/opt/stocksight/.env
ExecStart=/opt/stocksight/venv/bin/python src/data/daily_collector.py --full
TimeoutStartSec=1800
