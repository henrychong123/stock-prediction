[Unit]
Description=StockSight Web Dashboard (Gunicorn)
After=network.target

[Service]
Type=simple
User=stocksight
Group=stocksight
WorkingDirectory=/opt/stocksight
Environment=PATH=/opt/stocksight/venv/bin:/usr/bin
EnvironmentFile=/opt/stocksight/.env
ExecStart=/opt/stocksight/venv/bin/gunicorn -c /opt/stocksight/gunicorn.conf.py web.app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
