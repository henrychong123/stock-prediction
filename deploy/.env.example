# StockSight — Environment Variables for Oracle Cloud VM
# Copy this to /opt/stocksight/.env and fill in your keys

# Finnhub (free tier: 60 req/min) — stock data + news + earnings
FINNHUB_API_KEY=

# Reddit (optional) — social sentiment
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockSight/1.0

# NewsAPI (optional) — Malaysia news
NEWSAPI_KEY=

# Market setting
DEFAULT_MARKET=US
